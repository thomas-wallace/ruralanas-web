# Variables de la tienda nueva cuando corre contra la copia de prueba.
# `npm run staging:web` las aplica por encima de .env.local. No hay secretos
# acá: todo apunta a servicios locales.

NEXT_PUBLIC_SITE_URL=http://localhost:3020
# El WordPress de la copia (docker compose). La tienda le pasa las rutas de
# carrito, checkout y cuenta: ver src/middleware.ts.
WP_PROXY_ORIGIN=http://localhost:8080

CATALOG_SOURCE=woo
COMMERCE_SOURCE=woo-hosted
WOO_STORE_API_URL=http://localhost:8080/wp-json/wc/store/v1
WOO_CHECKOUT_URL=http://localhost:3020/checkout/
SKU_MAP_SOURCE=store-api

BLOG_SOURCE=wordpress
WP_API_URL=http://localhost:8080/wp-json/wp/v2
REVIEWS_SOURCE=woo
LEADS_SINK=log

# Contenido del admin de la copia, separado del de desarrollo.
CONTENT_DATA_DIR=staging/data/content
DEMO_HANDWORK_HOURS=

# Carpeta de compilación de la copia de prueba (separada de la de desarrollo).
NEXT_DIST_DIR=.next-staging
