# Dominio público del sitio. Define las URLs canónicas y las de Open Graph.
NEXT_PUBLIC_SITE_URL=https://ruralanas.com

# ─────────────────────────────────────────────────────────────────────────────
# Origen de datos del catálogo.
#   mock  → datos declarados en src/lib/catalog/mock-repository.ts
#   woo   → Store API pública de WooCommerce. El Woo de producción ya está
#           sincronizado con Dolibarr, así que esto trae catálogo, precios y
#           stock reales sin esperar al servicio de integración. Lo que no trae:
#           artesana, técnica ni horas de tejido.
#   http  → API del servicio de integración, que lee de Dolibarr (ERP)
# ─────────────────────────────────────────────────────────────────────────────
CATALOG_SOURCE=woo

# Base del servicio de integración (09-plataforma/servicio-integracion.md).
# Solo se usa cuando CATALOG_SOURCE=http. Nunca se expone al navegador.
INTEGRATION_API_URL=
INTEGRATION_API_TOKEN=

# Destino de los formularios (contacto, mayorista, newsletter).
#   log   → se escriben en consola (estado actual)
#   http  → van al servicio de integración, que los deja en HubSpot (CRM)
LEADS_SINK=log

# Token con el que el servicio de integración invalida el caché del catálogo
# tras sincronizar stock (POST /api/revalidate).
REVALIDATE_TOKEN=

# Analítica. Vacío = no se carga ningún script de terceros.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Motor transaccional: carrito, checkout, pedidos y pagos (D-010).
#   local      → repositorio de prototipo. Recorre el flujo entero pero NO COBRA.
#   woo        → WooCommerce headless con checkout propio. Ojo: la Store API
#                sólo expone las pasarelas compatibles con Blocks (hoy `bacs` y
#                `ppcp`), así que Stripe y Mercado Pago no pueden cobrar por acá.
#   woo-hosted → carrito propio y checkout alojado en Woo. Es el modo elegido
#                (D-017): conserva el diseño hasta el carrito y deja el cobro
#                donde todas las pasarelas funcionan.
#
# El navegador nunca habla con WordPress: todo pasa por /api/cart y
# /api/checkout de este mismo dominio. Por eso no hace falta habilitar CORS en
# WooCommerce ni se expone su dominio al visitante.
# ─────────────────────────────────────────────────────────────────────────────
COMMERCE_SOURCE=woo-hosted

# Raíz de la Store API. Necesaria con CATALOG_SOURCE=woo y con cualquiera de
# los COMMERCE_SOURCE de Woo.
WOO_STORE_API_URL=https://ruralanas.com/wp-json/wc/store/v1

# Página de checkout de WooCommerce, a donde se entrega el carrito.
# IMPORTANTE: para que el carrito viaje, el storefront y WooCommerce tienen que
# compartir origen. Con dominios distintos el navegador descarta las cookies de
# sesión y el cliente llega al checkout con el carrito vacío.
WOO_CHECKOUT_URL=https://ruralanas.com/checkout/

# Origen del mapa sku (Dolibarr) → id de WooCommerce.
#   store-api   → se le pregunta a la propia Store API por el SKU (sirve hoy)
#   integration → lo resuelve el servicio de integración, que conoce las dos
#                 puntas y es su casa definitiva
SKU_MAP_SOURCE=store-api

# ─────────────────────────────────────────────────────────────────────────────
# Reseñas (D-019). Son propias, no de Google: viven en WooCommerce, que ya es
# el admin donde la empresa entra, y se leen por su API pública — sin clave,
# sin costo y sin el tope de cinco reseñas que impone Google.
#   woo     → leídas de WooCommerce y cargables desde /admin/resenas
#   curated → la lista escrita a mano en src/lib/reviews/curated.ts
#   demo    → reseñas de MUESTRA, para mirar el diseño sin datos reales.
#             No son de nadie y no se guardan en ningún lado. La portada avisa
#             en pantalla mientras están activas, y el modo se ignora si
#             NODE_ENV es production: nunca se publican como reales.
# Con `woo`, si WordPress falla o no hay reseñas, cae solo a las curadas.
# ─────────────────────────────────────────────────────────────────────────────
REVIEWS_SOURCE=woo

# Claves de la API REST de WooCommerce, con permiso de LECTURA/ESCRITURA.
# Se generan en WooCommerce → Ajustes → Avanzado → API REST → Añadir clave.
# Sólo hacen falta para CARGAR reseñas desde el admin: leerlas no las necesita.
# Nunca viajan al navegador ni se ponen en una URL.
WOO_API_KEY=
WOO_API_SECRET=

# WooCommerce exige un email por reseña. Cuando no se sabe el de la persona
# —una reseña que llegó por WhatsApp, por ejemplo— se usa este.
REVIEWS_FALLBACK_EMAIL=resenas@ruralanas.com

# Contraseña del admin de reseñas (/[idioma]/admin/resenas). Mínimo 12
# caracteres. Sin esto, el admin queda cerrado y lo dice en pantalla.
# Cambiarla cierra todas las sesiones abiertas.
ADMIN_PASSWORD=
